# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL & API KEY: Connected backend for persistent appointment records
SUPABASE_URL="https://crnurqfbksebpzceymvq.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_Mz6a8H_JlVzq2ibHLzJZPA_Au838xw0"
VITE_SUPABASE_URL="https://crnurqfbksebpzceymvq.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_Mz6a8H_JlVzq2ibHLzJZPA_Au838xw0"

# GOOGLE OAUTH 2.0 CLIENT ID: Generated in Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
# Required for authenticating with Google and letting users select device Gmail accounts.
# Authorized JavaScript Origin: https://ais-dev-6uus4gtywz6in3cciapc6g-907369601424.asia-southeast1.run.app
# Authorized Redirect URI: https://ais-dev-6uus4gtywz6in3cciapc6g-907369601424.asia-southeast1.run.app
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
